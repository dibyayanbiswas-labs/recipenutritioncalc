{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "recipenutritioncalc",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{ "binding": "RESULTS_KV", "id": "514ec4818cab404a92ddb93ea43f4db4" }
	],
	"ai": {
		"binding": "AI"
	},
	// Per-IP throttle on the 4 recipe-submission actions (see src/actions/index.ts) — a speed bump
	// against a single script/bot hammering the site, on top of Turnstile's bot check. 60s is the
	// longest window this binding supports; there's no per-day option.
	"ratelimits": [{ "name": "SUBMIT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
	"observability": {
		"enabled": true
	}
}