---
import ThemeToggle from '../ui/ThemeToggle.astro';
---

<header class="h-16 border-b border-hairline bg-canvas print:hidden">
	<div class="max-w-[1400px] mx-auto h-full px-md sm:px-lg flex items-center justify-between">
		<a href="/" class="text-body-sm-strong text-ink flex items-center gap-xs">
			<span
				class="size-6 rounded-sm bg-primary text-on-primary flex items-center justify-center text-caption font-semibold"
				>N</span
			>
			Recipe Nutrition Calculator
		</a>
		<nav class="hidden md:flex items-center gap-sm text-body-sm text-body">
			<a href="/" class="rounded-full px-sm py-xs hover:text-ink hover:bg-canvas-soft">Home</a>
			<a href="/how-it-works" class="rounded-full px-sm py-xs hover:text-ink hover:bg-canvas-soft"
				>How it works</a
			>
			<a href="/about" class="rounded-full px-sm py-xs hover:text-ink hover:bg-canvas-soft">About</a>
		</nav>
