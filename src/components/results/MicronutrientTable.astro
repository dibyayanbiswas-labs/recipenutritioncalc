---
import type { NutrientProfile } from '../../lib/matchIngredient';
import { MICRO_META } from '../../lib/nutrientMeta';
import DVBar from './DVBar.astro';

interface Props {
	perServing: NutrientProfile;
	dailyValuePercent: Record<string, number>;
}

const { perServing, dailyValuePercent } = Astro.props;

// Split into two column-ordered halves rather than letting the grid auto-flow row by row, so each
// column can carry its own divide-y — a horizontal rule between rows only reads correctly when the
// rows above and below it belong to the same column.
const mid = Math.ceil(MICRO_META.length / 2);
const columns = [MICRO_META.slice(0, mid), MICRO_META.slice(mid)];
---

<div>
	<p class="text-body-sm-strong text-ink mb-sm">Vitamins &amp; minerals (per serving, % Daily Value)</p>
	<div class="grid sm:grid-cols-2 gap-x-lg">
		{
			columns.map((column, i) => (
				<div class:list={['sm:divide-y sm:divide-hairline', i === 1 && 'sm:border-l sm:border-hairline sm:pl-lg']}>
					{column.map((m) => (
						<DVBar
							label={m.label}
							value={perServing[m.key as keyof NutrientProfile] ?? 0}
							unit={m.unit}
							percent={dailyValuePercent[m.key] ?? 0}
							nutrientKey={m.key}
						/>
					))}
				</div>
			))
		}
	</div>
</div>
