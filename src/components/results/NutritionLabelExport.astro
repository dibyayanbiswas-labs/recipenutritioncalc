---
import type { NutritionResult } from '../../lib/nutrients';
import { MACRO_META, MICRO_META } from '../../lib/nutrientMeta';
import { LOW_COVERAGE_NUTRIENT_KEYS } from '../../lib/nutrientMath';
import type { NutrientProfile } from '../../lib/matchIngredient';

interface Props {
	result: NutritionResult;
}

const { result } = Astro.props;
const perServing = result.perServing;
---

<div id="nutrition-label" class="border-2 border-ink p-md w-full max-w-[360px] bg-canvas text-ink font-mono mx-auto">
	<h3 class="text-display-sm border-b-8 border-ink pb-1">Nutrition Facts</h3>
	<p class="text-caption border-b border-ink pb-1" data-label-servings>{result.servings} servings per recipe</p>
	<p class="text-body-md-strong border-b-4 border-ink py-1">Amount per serving</p>
	<div class="flex justify-between items-baseline border-b-4 border-ink py-1">
		<span class="text-body-lg font-bold">Calories</span>
		<span class="text-display-md" data-label-kcal>{Math.round(perServing.kcal)}</span>
	</div>
	<div class="divide-y divide-hairline-strong">
		{
			MACRO_META.map((m) => (
				<div class="flex justify-between text-body-sm py-0.5" data-label-row data-key={m.key}>
					<span>{m.label}</span>
					<span data-label-value>
						{perServing[m.key as keyof NutrientProfile]}
						{m.unit}
					</span>
				</div>
			))
		}
	</div>
	<div class="border-t-4 border-ink mt-xs pt-xs divide-y divide-hairline-strong">
		{
			MICRO_META.map((m) => (
				<div
					class="flex justify-between text-caption py-0.5"
					data-label-row
					data-key={m.key}
					hidden={(result.dailyValuePercent[m.key] ?? 0) <= 0 || LOW_COVERAGE_NUTRIENT_KEYS.has(m.key as keyof NutrientProfile)}
				>
					<span>{m.label}</span>
					<span data-label-dv>{result.dailyValuePercent[m.key] ?? 0}% DV</span>
				</div>
			))
		}
	</div>
	<p class="text-caption text-mute mt-xs">Estimated from a curated ingredient database - not FDA-verified.</p>
</div>

<button
	id="print-label"
	type="button"
	data-title={result.title}
	class="mt-sm text-body-sm-strong text-link hover:underline"
>
	Print / save as PDF
</button>

<script>
	import { printElementAsPdf } from '../../lib/printAsPdf';
	import { slugifyTitle } from '../../lib/slug';

	document.getElementById('print-label')?.addEventListener('click', (e) => {
		const title = (e.currentTarget as HTMLElement).dataset.title || 'recipe';
		printElementAsPdf('nutrition-label', `${slugifyTitle(title)}-nutrition-label`);
	});
</script>
