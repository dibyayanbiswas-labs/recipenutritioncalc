---
interface Props {
	label: string;
	value: number;
	unit: string;
	percent: number;
	nutrientKey?: string;
	/** Set when the bundled database has essentially no real data for this nutrient at all (see
	 * LOW_COVERAGE_NUTRIENT_KEYS) — shows "Not tracked" instead of a confident-looking 0%/empty bar,
	 * since that 0% would be an absence of data being displayed as if it were a measurement. */
	notTracked?: boolean;
}

const { label, value, unit, percent, nutrientKey, notTracked } = Astro.props;
const clamped = Math.min(100, Math.max(0, percent));
---

<div class="flex items-center gap-sm py-xxs" data-nutrient-row data-key={nutrientKey}>
	<span class="text-body-sm text-body w-[132px] shrink-0 truncate">{label}</span>
	{
		notTracked ? (
			<span class="flex-1 text-body-sm text-mute italic" data-not-tracked>
				Not tracked
			</span>
		) : (
			<>
				<div class="flex-1 h-1.5 rounded-full bg-canvas-soft-2 overflow-hidden">
					<div class="h-full bg-accent rounded-full" style={`width: ${clamped}%`} data-bar-fill />
				</div>
				<span class="text-body-sm text-mute w-[68px] shrink-0 text-right" data-bar-value>
					{value}
					{unit}
				</span>
				<span class="text-body-sm-strong text-ink w-[48px] shrink-0 text-right" data-bar-percent>
					{percent}%
				</span>
			</>
		)
	}
</div>
