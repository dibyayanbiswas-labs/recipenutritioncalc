---
import PasteTextForm from './PasteTextForm.astro';
import UrlForm from './UrlForm.astro';
import ManualEntryForm from './ManualEntryForm.astro';
import PhotoUploadForm from './PhotoUploadForm.astro';

interface Props {
	activeTab?: 'paste' | 'url' | 'manual' | 'photo';
	textError?: string | null;
	urlError?: string | null;
	manualError?: string | null;
	pasteServingsError?: string | null;
	urlServingsError?: string | null;
	manualServingsError?: string | null;
	pasteValue?: string;
	pasteTitle?: string;
	pasteServings?: number;
	urlValue?: string;
}

const {
	activeTab = 'paste',
	textError = null,
	urlError = null,
	manualError = null,
	pasteServingsError = null,
	urlServingsError = null,
	manualServingsError = null,
	pasteValue = '',
	pasteTitle = '',
	pasteServings,
	urlValue = '',
} = Astro.props;

const tabs = [
	{ id: 'paste', label: 'Paste text' },
	{ id: 'manual', label: 'Manual entry' },
	{ id: 'url', label: 'From a URL' },
	{ id: 'photo', label: 'Photo' },
] as const;
---

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<div>
	<p class="pwa-connectivity-note text-caption text-mute mb-sm">
		Using the installed app? Stay connected to the internet — recipe analysis needs it for accurate results.
	</p>
	<div role="tablist" class="flex flex-wrap gap-xs mb-lg" id="input-tabs">
		{
			tabs.map((tab) => (
				<button
					type="button"
					role="tab"
					data-tab={tab.id}
					aria-selected={tab.id === activeTab}
					class:list={[
						'text-body-sm rounded-pill-sm px-md h-9 border transition-colors',
						tab.id === activeTab
							? 'bg-primary text-on-primary border-primary'
							: 'bg-canvas text-ink border-hairline hover:bg-canvas-soft',
					]}
				>
					{tab.label}
				</button>
			))
		}
	</div>

	<div data-tab-panel="paste" hidden={activeTab !== 'paste'}>
		<PasteTextForm
			error={textError}
			servingsError={pasteServingsError}
			value={pasteValue}
			title={pasteTitle}
			servings={pasteServings}
		/>
	</div>
	<div data-tab-panel="url" hidden={activeTab !== 'url'}>
		<UrlForm error={urlError} servingsError={urlServingsError} value={urlValue} />
	</div>
	<div data-tab-panel="manual" hidden={activeTab !== 'manual'}>
		<ManualEntryForm error={manualError} servingsError={manualServingsError} />
	</div>
	<div data-tab-panel="photo" hidden={activeTab !== 'photo'}>
		<PhotoUploadForm />
	</div>
</div>

<script is:inline>
	(function () {
		var container = document.getElementById('input-tabs');
		if (!container) return;

		// One Turnstile widget per form, rendered lazily the first time its tab becomes visible —
		// rendering all four on page load would try to size widgets inside `hidden` (display:none)
		// panels, which Turnstile can't do reliably. Kept in the same script that already owns tab
		// switching so "tab becomes visible" has one place to hook into.
		var TURNSTILE_SITE_KEY = '0x4AAAAAAEXt8noz7I2XHJGk';
		var TURNSTILE_WIDGETS = {
			paste: { container: 'paste-turnstile', action: 'paste_text' },
			url: { container: 'url-turnstile', action: 'recipe_url' },
			manual: { container: 'manual-turnstile', action: 'manual_entry' },
			photo: { container: 'photo-turnstile', action: 'photo_upload' },
		};
		// Exposed so PhotoUploadForm's own script (which submits via fetch, not a native form POST)
		// can read the token and reset the widget after each attempt.
		window.__turnstileWidgetIds = window.__turnstileWidgetIds || {};

		function renderTurnstileFor(tabId) {
			if (window.__turnstileWidgetIds[tabId] !== undefined) return;
			var cfg = TURNSTILE_WIDGETS[tabId];
			var el = cfg && document.getElementById(cfg.container);
			if (!cfg || !el || !window.turnstile) return;
			window.__turnstileWidgetIds[tabId] = window.turnstile.render(el, {
				sitekey: TURNSTILE_SITE_KEY,
				action: cfg.action,
				appearance: 'interaction-only',
			});
		}

		function activate(tabId) {
			container.querySelectorAll('[role="tab"]').forEach(function (btn) {
				var isActive = btn.getAttribute('data-tab') === tabId;
				btn.setAttribute('aria-selected', String(isActive));
				btn.classList.toggle('bg-primary', isActive);
				btn.classList.toggle('text-on-primary', isActive);
				btn.classList.toggle('border-primary', isActive);
				btn.classList.toggle('bg-canvas', !isActive);
				btn.classList.toggle('text-ink', !isActive);
				btn.classList.toggle('border-hairline', !isActive);
			});
			document.querySelectorAll('[data-tab-panel]').forEach(function (panel) {
				panel.hidden = panel.getAttribute('data-tab-panel') !== tabId;
			});
			renderTurnstileFor(tabId);
		}

		container.querySelectorAll('[role="tab"]').forEach(function (btn) {
			btn.addEventListener('click', function () {
				activate(btn.getAttribute('data-tab'));
			});
		});

		window.activateInputTab = activate;

		// The external Turnstile script is loaded `async`, so it can finish (or already be cached and
		// finish near-instantly) before this inline script has even run — an `?onload=` callback isn't
		// reliable here since it can fire before this script defines it. Poll instead: cheap, short-lived
		// (the script is small and loads fast), and self-contained in the one place that already owns
		// tab state.
		(function waitForTurnstile() {
			if (window.turnstile) {
				var activeBtn = container.querySelector('[role="tab"][aria-selected="true"]');
				renderTurnstileFor(activeBtn ? activeBtn.getAttribute('data-tab') : 'paste');
				return;
			}
			setTimeout(waitForTurnstile, 100);
		})();
	})();
</script>

<style>
	/* Only relevant once installed — a browser tab has its own address bar for the
	   user to notice connectivity, so keep this hidden there and only surface it
	   when running standalone (installed PWA window). */
	.pwa-connectivity-note {
		display: none;
	}
	@media (display-mode: standalone) {
		.pwa-connectivity-note {
			display: block;
		}
	}
</style>
