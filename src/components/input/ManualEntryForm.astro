---
import { actions } from 'astro:actions';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';

interface Props {
	error?: string | null;
}

const { error = null } = Astro.props;
---

<form id="manual-form" method="POST" action={actions.analyzeManual} class="space-y-md">
	<div class="grid sm:grid-cols-[1fr_140px] gap-sm">
		<div>
			<label for="manual-title" class="text-body-sm-strong text-ink block mb-xxs">Recipe name (optional)</label>
			<Input id="manual-title" name="title" placeholder="e.g. Weeknight chicken curry" />
		</div>
		<div>
			<label for="manual-servings" class="text-body-sm-strong text-ink block mb-xxs">Servings</label>
			<Input id="manual-servings" name="servings" type="number" value="1" />
		</div>
	</div>

	<div id="manual-rows" class="space-y-xs">
		<div class="grid grid-cols-[80px_100px_1fr_36px] gap-xs items-center" data-row>
			<Input name="quantity" placeholder="2" />
			<Input name="unit" placeholder="cups" />
			<Input name="name" placeholder="all-purpose flour" />
			<button type="button" data-remove-row class="text-mute hover:text-error-deep text-body-sm" aria-label="Remove row"
				>&times;</button
			>
		</div>
	</div>

	<button type="button" id="add-row" class="text-body-sm-strong text-link hover:underline">+ Add ingredient</button>

	{error && <p class="text-body-sm text-error-deep" id="manual-error">{error}</p>}

	<div class="flex items-center gap-md">
		<Button type="submit" id="manual-submit">Calculate nutrition</Button>
		<Button type="button" id="manual-start-over" variant="secondary">Start over</Button>
	</div>
</form>

<template id="row-template">
	<div class="grid grid-cols-[80px_100px_1fr_36px] gap-xs items-center" data-row>
		<input
			name="quantity"
			placeholder="2"
			class="w-full h-10 bg-canvas text-ink border border-hairline rounded-sm px-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-link"
		/>
		<input
			name="unit"
			placeholder="cups"
			class="w-full h-10 bg-canvas text-ink border border-hairline rounded-sm px-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-link"
		/>
		<input
			name="name"
			placeholder="all-purpose flour"
			class="w-full h-10 bg-canvas text-ink border border-hairline rounded-sm px-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-link"
		/>
		<button type="button" data-remove-row class="text-mute hover:text-error-deep text-body-sm" aria-label="Remove row"
			>&times;</button
		>
	</div>
</template>

<script>
	import { clearSavedInput } from '../../lib/clearSavedInputs';

	const rowsContainer = document.getElementById('manual-rows')!;
	const template = document.getElementById('row-template') as HTMLTemplateElement;
	const addRowBtn = document.getElementById('add-row')!;
	const titleInput = document.getElementById('manual-title') as HTMLInputElement | null;
	const servingsInput = document.getElementById('manual-servings') as HTMLInputElement | null;

	const ROWS_KEY = 'recipeCalc:manualRows';
	const TITLE_KEY = 'recipeCalc:manualTitle';
	const SERVINGS_KEY = 'recipeCalc:manualServings';

	type SavedRow = { quantity: string; unit: string; name: string };

	function currentRows(): SavedRow[] {
		return Array.from(rowsContainer.querySelectorAll('[data-row]')).map((row) => ({
			quantity: (row.querySelector('[name="quantity"]') as HTMLInputElement)?.value ?? '',
			unit: (row.querySelector('[name="unit"]') as HTMLInputElement)?.value ?? '',
			name: (row.querySelector('[name="name"]') as HTMLInputElement)?.value ?? '',
		}));
	}

	function persistRows() {
		sessionStorage.setItem(ROWS_KEY, JSON.stringify(currentRows()));
	}

	function appendRow(values?: SavedRow) {
		const clone = template.content.cloneNode(true) as DocumentFragment;
		if (values) {
			(clone.querySelector('[name="quantity"]') as HTMLInputElement).value = values.quantity;
			(clone.querySelector('[name="unit"]') as HTMLInputElement).value = values.unit;
			(clone.querySelector('[name="name"]') as HTMLInputElement).value = values.name;
		}
		rowsContainer.appendChild(clone);
	}

	// A fresh page load always renders a single empty row from the server — restore whatever the
	// user last typed instead of leaving it blank, the same way the paste/URL tabs restore theirs.
	const savedRowsRaw = sessionStorage.getItem(ROWS_KEY);
	if (savedRowsRaw) {
		try {
			const savedRows = JSON.parse(savedRowsRaw) as SavedRow[];
			if (Array.isArray(savedRows) && savedRows.length > 0) {
				rowsContainer.innerHTML = '';
				savedRows.forEach((r) => appendRow(r));
			}
		} catch {
			// Corrupt/old sessionStorage value — ignore and keep the default empty row.
		}
	}
	if (titleInput && !titleInput.value) {
		const saved = sessionStorage.getItem(TITLE_KEY);
		if (saved) titleInput.value = saved;
	}

	document.getElementById('manual-start-over')?.addEventListener('click', () => {
		rowsContainer.innerHTML = '';
		appendRow();
		if (titleInput) titleInput.value = '';
		if (servingsInput) servingsInput.value = '1';
		clearSavedInput(ROWS_KEY);
		clearSavedInput(TITLE_KEY);
		clearSavedInput(SERVINGS_KEY);
	});

	addRowBtn.addEventListener('click', () => {
		appendRow();
		persistRows();
	});

	rowsContainer.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		if (target.matches('[data-remove-row]')) {
			const row = target.closest('[data-row]');
			if (rowsContainer.querySelectorAll('[data-row]').length > 1) {
				row?.remove();
				persistRows();
			}
		}
	});

	rowsContainer.addEventListener('input', persistRows);
	titleInput?.addEventListener('input', () => sessionStorage.setItem(TITLE_KEY, titleInput.value));
	servingsInput?.addEventListener('input', () => sessionStorage.setItem(SERVINGS_KEY, servingsInput.value));
</script>
