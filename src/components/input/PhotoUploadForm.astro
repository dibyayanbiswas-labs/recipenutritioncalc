---
import Button from '../ui/Button.astro';
---

<form id="photo-form" class="space-y-md">
	<div>
		<label for="photo-input" class="text-body-sm-strong text-ink block mb-xxs">Upload a photo of the recipe</label>
		<button
			type="button"
			id="photo-format-info-toggle"
			aria-expanded="false"
			aria-controls="photo-format-info-panel"
			class="flex items-center gap-xxs text-left text-caption text-mute mb-sm"
		>
			<span>Photograph the ingredient list itself, in focus and well-lit — not a photo of the finished dish.</span>
			<span class="text-link underline shrink-0">See examples</span>
		</button>
		<div
			id="photo-format-info-panel"
			role="note"
			class="hidden text-caption text-body bg-canvas-soft-2 border border-hairline rounded-sm p-sm mb-xs space-y-xxs"
		>
			<p><strong class="text-ink">Frame just the ingredients section</strong> — a cookbook page, recipe card, or printout, not the whole recipe card from a distance and not a photo of the cooked meal.</p>
			<p>Printed text is read most reliably. Legible handwriting works too, but the less clear it is, the more you'll need to fix in the review step.</p>
			<p>Avoid glare, blur, and steep angles — straight-on and well-lit gets the best transcription.</p>
			<p class="text-mute">You'll get a chance to review the transcribed text (and fix anything misread) before we calculate.</p>
		</div>
		<input
			id="photo-input"
			name="image"
			type="file"
			accept="image/*"
			required
			class="w-full text-body-sm text-body file:mr-sm file:h-9 file:px-sm file:rounded-pill file:border-0 file:bg-primary file:text-on-primary file:text-button-md"
		/>
	</div>
	<p id="photo-error" class="text-body-sm text-error-deep hidden"></p>
	<div class="flex items-center gap-md">
		<Button type="button" id="photo-submit">Transcribe photo</Button>
		<Button type="button" id="photo-start-over" variant="secondary">Start over</Button>
	</div>
</form>

<script>
	import { actions } from 'astro:actions';

	declare global {
		interface Window {
			activateInputTab?: (tab: string) => void;
		}
	}

	const fileInput = document.getElementById('photo-input') as HTMLInputElement;
	const submitBtn = document.getElementById('photo-submit') as HTMLButtonElement;
	const errorEl = document.getElementById('photo-error')!;

	const photoInfoToggle = document.getElementById('photo-format-info-toggle');
	const photoInfoPanel = document.getElementById('photo-format-info-panel');
	photoInfoToggle?.addEventListener('click', () => {
		const isOpen = !photoInfoPanel?.classList.contains('hidden');
		photoInfoPanel?.classList.toggle('hidden', isOpen);
		photoInfoToggle?.setAttribute('aria-expanded', String(!isOpen));
	});

	submitBtn.addEventListener('click', async () => {
		errorEl.classList.add('hidden');
		const file = fileInput.files?.[0];
		if (!file) {
			errorEl.textContent = 'Choose a photo first.';
			errorEl.classList.remove('hidden');
			return;
		}

		const originalLabel = submitBtn.textContent;
		submitBtn.textContent = 'Reading photo…';
		submitBtn.setAttribute('disabled', 'true');

		const formData = new FormData();
		formData.set('image', file);
		const { data, error } = await actions.transcribeImage(formData);

		submitBtn.textContent = originalLabel;
		submitBtn.removeAttribute('disabled');

		if (error) {
			errorEl.textContent = error.message;
			errorEl.classList.remove('hidden');
			return;
		}

		if (data) {
			const textarea = document.getElementById('ingredient-textarea') as HTMLTextAreaElement | null;
			if (textarea) {
				textarea.value = data.text;
			}
			window.activateInputTab?.('paste');
		}
	});

	document.getElementById('photo-start-over')?.addEventListener('click', () => {
		fileInput.value = '';
		errorEl.classList.add('hidden');
	});
</script>
