---
import Button from '../ui/Button.astro';
---

<form id="photo-form" class="space-y-md">
	<div>
		<label for="photo-input" class="text-body-sm-strong text-ink block mb-xxs">Upload a photo of the recipe</label>
		<button
			type="button"
			id="photo-format-info-toggle"
			aria-expanded="false"
			aria-controls="photo-format-info-panel"
			class="flex items-center gap-xxs text-left text-caption text-mute mb-sm"
		>
			<span>Photograph the ingredient list itself, in focus and well-lit - not a photo of the finished dish.</span>
			<span class="text-link underline shrink-0">See examples</span>
		</button>
		<div
			id="photo-format-info-panel"
			role="note"
			class="hidden text-caption text-body bg-canvas-soft-2 border border-hairline rounded-sm p-sm mb-xs space-y-xxs"
		>
			<p><strong class="text-ink">Frame just the ingredients section</strong> - a cookbook page, recipe card, or printout, not the whole recipe card from a distance and not a photo of the cooked meal.</p>
			<p>Printed text is read most reliably. Legible handwriting works too, but the less clear it is, the more you'll need to fix in the review step.</p>
			<p>Avoid glare, blur, and steep angles - straight-on and well-lit gets the best transcription.</p>
			<p class="text-mute">You'll get a chance to review the transcribed text (and fix anything misread) before we calculate.</p>
		</div>
		<input
			id="photo-input"
			name="image"
			type="file"
			accept="image/*"
			required
			class="w-full text-body-sm text-body file:mr-sm file:h-9 file:px-sm file:rounded-pill file:border-0 file:bg-primary file:text-on-primary file:text-button-md"
		/>
	</div>
	<p id="photo-error" class="text-body-sm text-error-deep hidden"></p>
	<div class="flex items-center gap-md">
		<Button type="button" id="photo-submit">Transcribe photo</Button>
		<Button type="button" id="photo-start-over" variant="secondary">Start over</Button>
	</div>
</form>

<script>
	import { actions } from 'astro:actions';

	declare global {
		interface Window {
			activateInputTab?: (tab: string) => void;
		}
	}

	const fileInput = document.getElementById('photo-input') as HTMLInputElement;
	const submitBtn = document.getElementById('photo-submit') as HTMLButtonElement;
	const errorEl = document.getElementById('photo-error')!;

	const photoInfoToggle = document.getElementById('photo-format-info-toggle');
	const photoInfoPanel = document.getElementById('photo-format-info-panel');
	photoInfoToggle?.addEventListener('click', () => {
		const isOpen = !photoInfoPanel?.classList.contains('hidden');
		photoInfoPanel?.classList.toggle('hidden', isOpen);
		photoInfoToggle?.setAttribute('aria-expanded', String(!isOpen));
	});

	// A full-resolution mobile camera photo is routinely 3-12MB at 3000-4000px on a side — converted to a
	// byte array and sent to Workers AI as-is, that's easily enough to blow the Worker's memory limit
	// ("exceeded maximum capacity"), long before the model even sees it. Recipe text is legible in a photo
	// at a fraction of that resolution, so shrink client-side before it ever leaves the browser. A file
	// already this small (typical of a screenshot) is left untouched — re-encoding it would only cost
	// quality for no size benefit.
	const SKIP_RESIZE_BELOW_BYTES = 1.5 * 1024 * 1024;
	const MAX_DIMENSION_PX = 1600;
	const JPEG_QUALITY = 0.82;
	// Final safety net for anything resizing couldn't shrink (e.g. createImageBitmap unsupported) —
	// matches the server's own cap in src/actions/index.ts, so an oversized photo is rejected instantly
	// in the browser instead of round-tripping to the Worker just to be rejected there.
	const MAX_UPLOAD_BYTES = 8 * 1024 * 1024;

	async function prepareImageForUpload(file: File): Promise<File> {
		if (file.size <= SKIP_RESIZE_BELOW_BYTES) return file;

		try {
			const bitmap = await createImageBitmap(file);
			const scale = Math.min(1, MAX_DIMENSION_PX / Math.max(bitmap.width, bitmap.height));
			const width = Math.max(1, Math.round(bitmap.width * scale));
			const height = Math.max(1, Math.round(bitmap.height * scale));

			const canvas = document.createElement('canvas');
			canvas.width = width;
			canvas.height = height;
			const ctx = canvas.getContext('2d');
			if (!ctx) return file;
			ctx.drawImage(bitmap, 0, 0, width, height);
			bitmap.close();

			const blob: Blob | null = await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', JPEG_QUALITY));
			if (!blob || blob.size >= file.size) return file;
			const jpgName = file.name.replace(/\.[^.]+$/, '') + '.jpg';
			return new File([blob], jpgName, { type: 'image/jpeg' });
		} catch {
			// Best-effort optimization only — if anything about resizing fails (unsupported format,
			// memory pressure), fall back to the original file rather than blocking the upload entirely.
			return file;
		}
	}

	// The astro:actions client has no way to pass an AbortSignal through, so a stuck request (observed
	// in practice: the server responds but the client-side handler never resolves) would otherwise leave
	// the button disabled forever with no way to retry. Race it against a generous timeout instead, so
	// the UI always recovers even if the underlying request never does.
	const RESPONSE_TIMEOUT_MS = 45_000;
	function withTimeout<T>(promise: Promise<T>, ms: number): Promise<T> {
		return new Promise((resolve, reject) => {
			const timer = setTimeout(() => reject(new Error('timeout')), ms);
			promise.then(
				(v) => {
					clearTimeout(timer);
					resolve(v);
				},
				(e) => {
					clearTimeout(timer);
					reject(e);
				},
			);
		});
	}

	submitBtn.addEventListener('click', async () => {
		errorEl.classList.add('hidden');
		const file = fileInput.files?.[0];
		if (!file) {
			errorEl.textContent = 'Choose a photo first.';
			errorEl.classList.remove('hidden');
			return;
		}

		const originalLabel = submitBtn.textContent;
		submitBtn.textContent = 'Preparing photo…';
		submitBtn.setAttribute('disabled', 'true');

		try {
			const prepared = await prepareImageForUpload(file);
			if (prepared.size > MAX_UPLOAD_BYTES) {
				errorEl.textContent = "That photo is too large even after compression - try cropping it to just the ingredient list, or paste the ingredients instead.";
				errorEl.classList.remove('hidden');
				return;
			}

			submitBtn.textContent = 'Reading photo…';
			const formData = new FormData();
			formData.set('image', prepared);
			const { data, error } = await withTimeout(actions.transcribeImage(formData), RESPONSE_TIMEOUT_MS);

			if (error) {
				errorEl.textContent = error.message;
				errorEl.classList.remove('hidden');
				return;
			}

			if (data) {
				const textarea = document.getElementById('ingredient-textarea') as HTMLTextAreaElement | null;
				if (textarea) {
					textarea.value = data.text;
				}
				window.activateInputTab?.('paste');
			}
		} catch {
			errorEl.textContent = "That's taking longer than expected. Check your connection and try again, or paste the ingredients instead.";
			errorEl.classList.remove('hidden');
		} finally {
			submitBtn.textContent = originalLabel;
			submitBtn.removeAttribute('disabled');
		}
	});

	document.getElementById('photo-start-over')?.addEventListener('click', () => {
		fileInput.value = '';
		errorEl.classList.add('hidden');
	});
</script>
