---
import { actions } from 'astro:actions';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';

interface Props {
	error?: string | null;
	servingsError?: string | null;
	value?: string;
}

const { error = null, servingsError = null, value = '' } = Astro.props;
---

<form method="POST" action={actions.analyzeUrl} class="space-y-md">
	<div>
		<label for="recipe-url" class="text-body-sm-strong text-ink block mb-xxs">Recipe URL</label>
		<button
			type="button"
			id="url-format-info-toggle"
			aria-expanded="false"
			aria-controls="url-format-info-panel"
			class="flex items-center gap-xxs text-left text-caption text-mute mb-sm"
		>
			<span>Link straight to the recipe page itself — not the site's homepage or a search results page.</span>
			<span class="text-link underline shrink-0">See examples</span>
		</button>
		<div
			id="url-format-info-panel"
			role="note"
			class="hidden text-caption text-body bg-canvas-soft-2 border border-hairline rounded-sm p-sm mb-xs space-y-xxs"
		>
			<p><strong class="text-ink">Use the exact page for one recipe</strong>, e.g. <span class="font-mono">https://example.com/recipes/chicken-curry</span> — not the homepage, a category page, or a roundup listing several recipes.</p>
			<p>We look for the structured recipe data most recipe blogs and major recipe sites embed (the same data Google uses for recipe search results). Not every site publishes it.</p>
			<p>Some sites block automated requests outright, even when they do publish that data — you may see a "Couldn't fetch that page" error. If that happens, open the page yourself, copy the ingredient list, and use Paste text instead.</p>
		</div>
		<Input id="recipe-url" name="url" type="url" required placeholder="https://example.com/my-recipe" value={value} />
		{error && <p class="text-body-sm text-error-deep mt-xxs">{error}</p>}
	</div>
	<div class="max-w-[200px]">
		<label for="url-servings" class="text-body-sm-strong text-ink block mb-xxs">Servings override (optional)</label>
		<Input id="url-servings" name="servingsOverride" type="number" placeholder="Auto-detected" />
		{servingsError && <p class="text-body-sm text-error-deep mt-xxs">{servingsError}</p>}
	</div>
	<div class="flex items-center gap-md">
		<Button type="submit">Fetch &amp; calculate</Button>
		<Button type="button" id="url-start-over" variant="secondary">Start over</Button>
	</div>
</form>

<script>
	import { clearSavedInput } from '../../lib/clearSavedInputs';

	const urlInput = document.getElementById('recipe-url') as HTMLInputElement | null;
	const servingsInput = document.getElementById('url-servings') as HTMLInputElement | null;

	const urlInfoToggle = document.getElementById('url-format-info-toggle');
	const urlInfoPanel = document.getElementById('url-format-info-panel');
	urlInfoToggle?.addEventListener('click', () => {
		const isOpen = !urlInfoPanel?.classList.contains('hidden');
		urlInfoPanel?.classList.toggle('hidden', isOpen);
		urlInfoToggle?.setAttribute('aria-expanded', String(!isOpen));
	});

	document.getElementById('url-start-over')?.addEventListener('click', () => {
		if (urlInput) urlInput.value = '';
		if (servingsInput) servingsInput.value = '';
		clearSavedInput('recipeCalc:url');
		clearSavedInput('recipeCalc:urlServings');
		urlInput?.focus();
	});

	const fields = [
		{ id: 'recipe-url', key: 'recipeCalc:url' },
		{ id: 'url-servings', key: 'recipeCalc:urlServings' },
	];
	fields.forEach((f) => {
		const el = document.getElementById(f.id) as HTMLInputElement | null;
		if (!el) return;
		if (!el.value) {
			const saved = sessionStorage.getItem(f.key);
			if (saved) el.value = saved;
		}
		el.addEventListener('input', () => {
			sessionStorage.setItem(f.key, el.value);
		});
	});
</script>
