---
interface Props {
	size?: 'sm' | 'md' | 'lg';
	type?: 'text' | 'number' | 'email' | 'url' | 'password' | 'search' | 'tel';
	name?: string;
	id?: string;
	placeholder?: string;
	required?: boolean;
	value?: string | number;
	min?: string | number;
	max?: string | number;
	step?: string | number;
	class?: string;
	[key: `data-${string}`]: string | undefined;
}

const {
	size = 'md',
	type = 'text',
	name,
	id,
	placeholder,
	required = false,
	value,
	min,
	max,
	step,
	class: className,
	...rest
} = Astro.props;

const sizes = {
	sm: 'h-8 text-body-sm',
	md: 'h-10 text-body-sm',
	lg: 'h-12 text-body-md',
};

const classes = [
	'w-full bg-canvas text-ink border border-hairline rounded-sm px-sm focus:outline-none focus:ring-2 focus:ring-link',
	sizes[size],
	className,
]
	.filter(Boolean)
	.join(' ');
---

<input
	type={type}
	name={name}
	id={id}
	placeholder={placeholder}
	required={required}
	value={value}
	min={min}
	max={max}
	step={step}
	class={classes}
	{...rest}
/>
