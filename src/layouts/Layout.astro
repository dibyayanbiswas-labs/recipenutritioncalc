---
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';
import NavBar from '../components/layout/NavBar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Recipe Nutrition Calculator — accurate macros & micros, no login',
	description = 'Paste a recipe, a URL, or a photo and get calories, full macros, and 20+ micronutrients per serving — free, no account, no paywall.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<script is:inline>
			(function () {
				var stored = localStorage.getItem('theme');
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (stored === 'dark' || (!stored && prefersDark)) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
		<script is:inline>
			(function () {
				// A manual browser refresh should behave like "Start over" and drop any in-progress,
				// unsubmitted form input — only an actual reload qualifies, not a normal navigation
				// (e.g. the redirect Astro does right after a form submission).
				try {
					var nav = performance.getEntriesByType('navigation')[0];
					if (nav && nav.type === 'reload') {
						['recipeCalc:pasteTitle', 'recipeCalc:pasteServings', 'recipeCalc:pasteText', 'recipeCalc:url', 'recipeCalc:urlServings'].forEach(
							function (k) {
								sessionStorage.removeItem(k);
							},
						);
					}
				} catch (e) {
					// sessionStorage/Performance API can throw in locked-down privacy modes — best-effort.
				}
			})();
		</script>
	</head>
	<body class="min-h-screen flex flex-col">
		<NavBar />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
