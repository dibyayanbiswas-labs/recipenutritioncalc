---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact - Recipe Nutrition Calculator"
	description="Get in touch with the Recipe Nutrition Calculator team - questions, feedback, or a nutrition data correction."
>
	<section class="max-w-[720px] mx-auto px-md sm:px-lg py-3xl">
		<h1 class="text-display-lg text-ink mb-lg">Contact</h1>
		<div class="space-y-md text-body-md text-body">
			<p>
				Questions, feedback, or spotted a nutrition figure that looks off? Email us and we'll get back to
				you.
			</p>
			<p>
				<a href="mailto:support@recipenutritioncalc.com" class="text-link hover:underline"
					>support@recipenutritioncalc.com</a
				>
			</p>
			<p>
				If you're reporting an incorrect result, include the share link so we can look into the specific
				ingredients involved.
			</p>
		</div>
	</section>
</Layout>
